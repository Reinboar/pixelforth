CONSTANT: MGBA_DEBUG_STR 04FFF600h
CONSTANT: MGBA_DEBUG_FLAGS 04FFF700h
CONSTANT: MGBA_DEBUG_ENABLE 04FFF780h

: WRITE-DBG-STR ( str -- )
  MGBA_DEBUG_STR STRCPY
;

: MGBA-DEBUG-ENABLE ( -- )
  C0DEh MGBA_DEBUG_ENABLE H!
;

: MGBA-DEBUG-DISABLE ( -- )
  0000h MGBA_DEBUG_ENABLE H!
;

: MGBA-FATAL-MSG ( str -- )
  MGBA_DEBUG_STR STRCPY
  100h MGBA_DEBUG_FLAGS H!
;

: MGBA-ERROR-MSG ( str -- )
  MGBA_DEBUG_STR STRCPY
  101h MGBA_DEBUG_FLAGS H!
;

: MGBA-WARN-MSG ( str -- )
  MGBA_DEBUG_STR STRCPY
  102h MGBA_DEBUG_FLAGS H!
;

: MGBA-INFO-MSG ( str -- )
  MGBA_DEBUG_STR STRCPY
  103h MGBA_DEBUG_FLAGS H!
;

: MGBA-STUB-MSG ( str -- )
  MGBA_DEBUG_STR STRCPY
  104h MGBA_DEBUG_FLAGS H!
;

: MGBA-DEBUG-MSG ( str -- )
  MGBA_DEBUG_STR STRCPY
  104h MGBA_DEBUG_FLAGS H!
;
