INCLUDE" gba-prelude.ft"
INCLUDE" mgba.ft"

MGBA-DEBUG-ENABLE

\ [
    KEYINPUT H@ FFFFh ^ \ Negate KEYINPUT so that set bits are pressed and cleared bits are released
             DUP BUTTON-A &     [ " A"     MGBA-ERROR-MSG ] WHEN
             DUP BUTTON-B &     [ " B"     MGBA-ERROR-MSG ] WHEN
             DUP BUTTON-START & [ " START" MGBA-ERROR-MSG ] WHEN
    DROP
\ 01h ] WHILE
" DONE" MGBA-INFO-MSG
