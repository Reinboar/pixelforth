\ *** LCD I/O REGISTERS ***
CONSTANT: DISPCNT    04000000h
CONSTANT: GREEN-SWAP 04000002h \ Undocumented by Nintendo
CONSTANT: DISPSTAT   04000004h
CONSTANT: VCOUNT     04000006h \ Read only

\ Background Memory
CONSTANT: BGPAL      05000000h \ Background Palette memory (512 bytes)

\ Background Control Registers
CONSTANT: BG0CNT     04000008h
CONSTANT: BG1CNT     0400000Ah
CONSTANT: BG2CNT     0400000Ch
CONSTANT: BG3CNT     0400000Eh

\ Background Offset Registers
CONSTANT: BG0HOFS    04000010h
CONSTANT: BG0VOFS    04000012h
CONSTANT: BG1HOFS    04000014h
CONSTANT: BG1VOFS    04000016h
CONSTANT: BG2HOFS    04000018h
CONSTANT: BG2VOFS    0400001Ah
CONSTANT: BG3HOFS    0400001Ch
CONSTANT: BG3VOFS    0400001Eh

\ Background Scaling Registers
CONSTANT: BG2PA      04000020h
CONSTANT: BG2PB      04000022h
CONSTANT: BG2PC      04000024h
CONSTANT: BG2PD      04000026h
CONSTANT: BG2X       04000028h
CONSTANT: BG2Y       0400002Ch
CONSTANT: BG3PA      04000030h
CONSTANT: BG3PB      04000032h
CONSTANT: BG3PC      04000034h
CONSTANT: BG3PD      04000036h
CONSTANT: BG3X       04000038h
CONSTANT: BG3Y       0400003Ch

\ Window Registers
CONSTANT: WIN0H      04000040h
CONSTANT: WIN1H      04000042h
CONSTANT: WIN0V      04000044h
CONSTANT: WIN1V      04000046h
CONSTANT: WININ      04000048h
CONSTANT: WINOUT     0400004Ah
CONSTANT: MOSAIC     0400004Ch
CONSTANT: BLDCNT     04000050h
CONSTANT: BLDALPHA   04000052h
CONSTANT: BLDY       04000054h


\ *** SOUND I/O REGISTERS ***
\ Channel 1
CONSTANT: SOUND1CNT_L 04000060h \ Sweep register
CONSTANT: SOUND1CNT_H 04000062h \ Duty/Length/Envelope
CONSTANT: SOUND1CNT_X 04000064h \ Frequency/Control

\ Channel 2
CONSTANT: SOUND2CNT_L 04000068h \ Duty/Length/Envelope
CONSTANT: SOUND2CNT_H 0400006Ch \ Frequency/Control

\ Channel 3
CONSTANT: SOUND3CNT_L 04000070h \ Stop/Wave RAM Select
CONSTANT: SOUND3CNT_H 04000072h \ Length/Volume
CONSTANT: SOUND3CNT_X 04000074h \ Frequency/Control

\ Channel 4
CONSTANT: SOUND4CNT_L 04000078h \ Length/Envelope
CONSTANT: SOUND4CNT_H 0400007Ch \ Frequency/Control

\ Master
CONSTANT: SOUNDCNT_L  04000080h \ Control Stereo/Volume/Enable
CONSTANT: SOUNDCNT_H  04000082h \ Control Mixing/DMA Control
CONSTANT: SOUNDCNT_X  04000084h \ Control Sound On/Off
CONSTANT: SOUNDBIAS   04000088h \ PWM Control

\ Channel 3 Wave Pattern RAM
CONSTANT: WAVE_RAM    04000090h \ 4-bit sample audio RAM

\ Direct Sound FIFO
CONSTANT: FIFO_A      040000A0h \ Channel A FIFO
CONSTANT: FIFO_B      040000A4h \ Channel B FIFO


\ *** DMA TRANSFER REGISTERS ***
\ DMA 0 Registers
CONSTANT: DMA0SAD     040000B0h \ DMA 0 Source Address
CONSTANT: DMA0DAD     040000B4h \ DMA 0 Destination Address
CONSTANT: DMA0CNT_L   040000B8h \ DMA 0 Word Count
CONSTANT: DMA0CNT_H   040000BAh \ DMA 0 Control

\ DMA 1 Registers
CONSTANT: DMA1SAD     040000BCh \ DMA 1 Source Address
CONSTANT: DMA1DAD     040000C0h \ DMA 1 Destination Address
CONSTANT: DMA1CNT_L   040000C4h \ DMA 1 Word Count
CONSTANT: DMA1CNT_H   040000C6h \ DMA 1 Control

\ DMA 2 Registers
CONSTANT: DMA2SAD     040000C8h \ DMA 2 Source Address
CONSTANT: DMA2DAD     040000CCh \ DMA 2 Destination Address
CONSTANT: DMA2CNT_L   040000D0h \ DMA 2 Word Count
CONSTANT: DMA2CNT_H   040000D2h \ DMA 2 Control

\ DMA 3 Registers
CONSTANT: DMA3SAD     040000D4h \ DMA 3 Source Address
CONSTANT: DMA3DAD     040000D8h \ DMA 3 Destination Address
CONSTANT: DMA3CNT_L   040000DCh \ DMA 3 Word Count
CONSTANT: DMA3CNT_H   040000DEh \ DMA 3 Control


\ *** TIMER REGISTERS ***
\ Timer 0
CONSTANT: TM0CNT_L    04000100h \ Timer 0 Counter/Reload
CONSTANT: TM0CNT_H    04000102h \ Timer 0 Control

\ Timer 1
CONSTANT: TM1CNT_L    04000104h \ Timer 1 Counter/Reload
CONSTANT: TM1CNT_H    04000106h \ Timer 1 Control

\ Timer 2
CONSTANT: TM2CNT_L    04000108h \ Timer 2 Counter/Reload
CONSTANT: TM2CNT_H    0400010Ah \ Timer 2 Control

\ Timer 3
CONSTANT: TM3CNT_L    0400010Ch \ Timer 3 Counter/Reload
CONSTANT: TM3CNT_H    0400010Eh \ Timer 3 Control


\ *** KEYPAD INPUT REGISTERS ***
CONSTANT: KEYINPUT    04000130h \ Key Status
CONSTANT: KEYCNT      04000132h \ Key Interrupt Control


\ *** SERIAL COMMUNICATION REGISTERS ***
CONSTANT: SIODATA32   04000120h \ SIO Data (32-bit Mode)
CONSTANT: SIOMULTI0   04000120h \ SIO Data 0 (Parent) (Multiplayer Mode)
CONSTANT: SIOMULTI1   04000122h \ SIO Data 1 (1st Child) (Multiplayer Mode)
CONSTANT: SIOMULTI2   04000124h \ SIO Data 2 (2nd Child) (Multiplayer Mode)
CONSTANT: SIOMULTI3   04000126h \ SIO Data 3 (3rd Child) (Multiplayer Mode)
CONSTANT: SIOCNT      04000128h \ SIO Control Register
CONSTANT: SIOMLT_SEND 0400012Ah \ SIO Data
CONSTANT: SIODATA8    0400012Ah \ SIO Data (Normal 8-bit Mode and UART Mode)
CONSTANT: RCNT        04000134h \ SIO Mode Select/General Purpose Data
CONSTANT: IR          04000136h \ Infrared Register (Prototype Units Only)
CONSTANT: JOYCNT      04000140h \ SIO JOY Bus Control
CONSTANT: JOY_RECV    04000150h \ SIO JOY Bus Receive Data
CONSTANT: JOY_TRANS   04000154h \ SIO JOY Bus Transmit Data
CONSTANT: JOYSTAT     04000158h \ SIO JOY Bus Receive Status


\ *** INTERRUPT REGISTERS ***
CONSTANT: INTENABLE          04000200h \ Interrupt Enable Register
CONSTANT: INTFLAGS          04000202h \ Interrupt Request Flags
CONSTANT: WAITCNT     04000204h \ GamePak Waitstate Control
CONSTANT: IME         04000208h \ Interrupt Master Enable Register
CONSTANT: POSTFLG     04000300h \ Post Boot Flag (Undocumented)
CONSTANT: HALTCNT     04000301h \ Power Down Control (Undocumented)


\ *** OAM REGISTERS / MEMORY ***
CONSTANT: OAM         07000000h \ OAM OBJ memory
CONSTANT: OAMPAL      05000200h \ OAM Palette memory
